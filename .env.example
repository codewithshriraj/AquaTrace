# ==============================================================================
# AQUATRACE SCIENTIFIC ENVIRONMENT CONFIGURATION
# Copy to .env and configure local or production credentials
# NEVER COMMIT REAL CREDENTIALS, PASSWORDS, OR BEARER TOKENS
# ==============================================================================

# CARTO Basemaps API Key (High-performance tactical dark and voyager charts)
# Register at: https://carto.com/
VITE_CARTO_API_KEY=your_carto_basemaps_api_key_here

# Copernicus Data Space Ecosystem (CDSE)
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CDSE_USERNAME=your_copernicus_email_here
COPERNICUS_CDSE_PASSWORD=your_copernicus_password_here
COPERNICUS_CDSE_CLIENT_ID=cdse-public
COPERNICUS_CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CDSE_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products

# AquaTrace Backend Server Configuration
AQUATRACE_BACKEND_PORT=8000
AQUATRACE_BACKEND_HOST=0.0.0.0
AQUATRACE_DATA_DIR=data/sentinel1
AQUATRACE_MAX_PRODUCT_SIZE_MB=2500
AQUATRACE_CACHE_TTL_HOURS=72

# Metocean Providers (Optional API Keys, Open-Meteo runs free tier)
NOAA_GFS_ENABLED=true
INCOIS_ENABLED=true

# AIS Providers (Optional keys for real-time AIS, defaults to public GFW / DGLL)
GLOBAL_FISHING_WATCH_API_KEY=your_gfw_api_key_optional
AISSTREAM_API_KEY=your_aisstream_api_key_optional
